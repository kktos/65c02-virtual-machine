10 S = 7 : REM SLOT 7
20 B = 49152 + (S * 256) : REM BASE ADDRESS $C700
30 PB = B : PA = B + 1 : REM ORB, ORA ("ORB" WOULD READ AS "OR B")
40 DB = B + 2 : DA = B + 3 : REM DDRB, DDRA
50 REM INIT VIA PORTS TO OUTPUT
60 POKE DB, 255 : POKE DA, 255
70 REM RESET AY CHIP (RESET LOW THEN HIGH)
80 POKE PB, 0 : POKE PB, 4
90 REM ENABLE TONE A (MIXER REG 7 = 62/0x3E)
100 R=7 : V=62 : GOSUB 1000
110 REM SET MAX VOLUME A (REG 8 = 15)
120 R=8 : V=15 : GOSUB 1000
130 REM SET COARSE TUNE A (REG 1 = 0)
140 R=1 : V=0 : GOSUB 1000
150 REM SWEEP FINE TUNE A (REG 0)
160 FOR I = 0 TO 255
170 R=0 : V=I : GOSUB 1000
180 NEXT I
185 N = N + 1 : IF N < 3 THEN 160 : REM 3 SWEEPS
190 REM SILENCE IT: THE AY PLAYS ON UNTIL TOLD (VOLUME A = 0)
195 R=8 : V=0 : GOSUB 1000
999 END
1000 REM SUBROUTINE: WRITE REGISTER R WITH VALUE V
1010 POKE PA, R
1020 POKE PB, 7 : POKE PB, 4 : REM LATCH ADDRESS
1030 POKE PA, V
1040 POKE PB, 6 : POKE PB, 4 : REM WRITE DATA
1050 RETURN
